# Copy this file to .env and fill in SMTP values when enabling real email OTP.
APP_ENV=local
APP_URL=http://localhost/Ordering
APP_TIMEZONE=Asia/Manila
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=unicanteen
DB_USERNAME=root
